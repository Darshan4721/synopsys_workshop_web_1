{
  "design_system": "Sri Shakthi Synopsys Luxury Semiconductor Design System (v2.0)",
  "fonts": {
    "display_serif": "var(--font-display-serif), 'Instrument Serif', 'Cormorant Garamond', 'Playfair Display', serif",
    "body_sans": "var(--font-sans), 'Plus Jakarta Sans', 'Syne', system-ui, -apple-system, sans-serif",
    "code_mono": "'JetBrains Mono', 'Fira Code', monospace"
  },
  "palette": {
    "canvas_light": "#ffffff",
    "canvas_subtle": "#faf7ff",
    "canvas_card": "rgba(255, 255, 255, 0.85)",
    "synopsys_purple": {
      "50": "#faf5ff",
      "100": "#f3e8ff",
      "200": "#e9d5ff",
      "300": "#d8b4fe",
      "400": "#c084fc",
      "500": "#a855f7",
      "600": "#9333ea",
      "700": "#7e22ce",
      "800": "#581c87",
      "900": "#3b0764",
      "950": "#1f0438"
    },
    "metallic_gold": {
      "400": "#fbbf24",
      "500": "#f59e0b",
      "600": "#d97706"
    },
    "slate_neutral": {
      "50": "#f8fafc",
      "100": "#f1f5f9",
      "200": "#e2e8f0",
      "300": "#cbd5e1",
      "500": "#64748b",
      "700": "#334155",
      "900": "#0f172a"
    }
  },
  "double_bezel": {
    "outer": "p-1.5 md:p-2 rounded-[2rem] bg-purple-950/5 border border-purple-500/15 backdrop-blur-xl shadow-[0_8px_32px_rgba(76,29,149,0.06)]",
    "inner": "rounded-[calc(2rem-0.375rem)] bg-white/90 border border-purple-100 shadow-[inset_0_1px_1px_rgba(255,255,255,0.9)]"
  },
  "animation_timing": {
    "ease_out_punch": "cubic-bezier(0.23, 1, 0.32, 1)",
    "spring_snappy": "cubic-bezier(0.32, 0.72, 0, 1)",
    "button_press": "scale-[0.98] transition-transform duration-150"
  }
}
